#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: setup-machine [auto|x86|x86-cpu|linux-aarch64|l4t|mac]

  auto (default)  pick the setup that fits this machine:
                    x86-64 Linux + NVIDIA GPU    -> x86            (make setup x86)
                    x86-64 Linux, no NVIDIA GPU  -> x86-cpu        (native Pixi, no Docker)
                    NVIDIA Jetson                -> l4t            (make setup l4t)
                    other ARM64 Linux            -> linux-aarch64  (make setup linux-aarch64)
                    Apple-Silicon Mac            -> mac            (make setup mac)

  A platform that doesn't fit this machine is refused before anything is installed.

Environment:
  DRY_RUN=1    show what would be installed; change nothing
  SKIP_APT=1   don't apt-install host packages
EOF
}

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
ws="$repo_root/ros2_ws"
DRY_RUN="${DRY_RUN:-0}"
SKIP_APT="${SKIP_APT:-}"
pixi_version="$(sed -n 's/^PIXI_VERSION := *//p' "$repo_root/Makefile")"
apt_packages=(curl can-utils kmod xvfb)

say() { printf '\033[1;34m[setup]\033[0m %s\n' "$*"; }
die() { printf '\033[1;31m[setup]\033[0m %s\n' "$*" >&2; exit 1; }
run() {
  if [[ "$DRY_RUN" == 1 ]]; then printf '  would run: %s\n' "$*"; else "$@"; fi
}
run_sh() {
  if [[ "$DRY_RUN" == 1 ]]; then printf '  would run: %s\n' "$1"; else bash -c "$1"; fi
}

has_nvidia() {
  [[ -f /etc/nv_tegra_release ]] && return 0
  local dev
  for dev in /sys/bus/pci/devices/*; do
    [[ "$(cat "$dev/vendor" 2>/dev/null)" == 0x10de && "$(cat "$dev/class" 2>/dev/null)" == 0x03* ]] && return 0
  done
  return 1
}

machine="$(uname -s)/$(uname -m)"

detect() {
  case "$machine" in
    Darwin/arm64) echo mac ;;
    Linux/x86_64) if has_nvidia; then echo x86; else echo x86-cpu; fi ;;
    Linux/aarch64) if [[ -f /etc/nv_tegra_release ]]; then echo l4t; else echo linux-aarch64; fi ;;
    *) die "no setup for $machine." ;;
  esac
}

misfit() {
  case "$1" in
    x86)
      [[ "$machine" == Linux/x86_64 ]] || { echo "x86 needs x86-64 Linux; this is $machine."; return; }
      has_nvidia || echo "x86 needs an NVIDIA GPU and this machine has none. Use x86-cpu (auto picks it here)." ;;
    x86-cpu) [[ "$machine" == Linux/x86_64 ]] || echo "x86-cpu needs x86-64 Linux; this is $machine." ;;
    linux-aarch64) [[ "$machine" == Linux/aarch64 ]] || echo "linux-aarch64 needs ARM64 Linux; this is $machine." ;;
    l4t) [[ -f /etc/nv_tegra_release ]] || echo "l4t needs an NVIDIA Jetson; this machine isn't one." ;;
    mac) [[ "$machine" == Darwin/arm64 ]] || echo "mac needs an Apple-Silicon Mac; this is $machine." ;;
    *) echo "unknown platform '$1'." ;;
  esac
}

setup_x86_cpu() {
  say "x86-64 without an NVIDIA GPU: the ROS 2 'default' Pixi environment runs natively, no Docker."

  if [[ -n "$SKIP_APT" ]] || ! command -v apt-get >/dev/null; then
    say "1/4 Host packages: skipped."
  else
    local missing=() pkg
    for pkg in "${apt_packages[@]}"; do
      dpkg -s "$pkg" &>/dev/null || missing+=("$pkg")
    done
    if [[ ${#missing[@]} -eq 0 ]]; then
      say "1/4 Host packages: already installed."
    else
      say "1/4 Host packages: installing ${missing[*]}"
      run sudo apt-get update
      run sudo apt-get install -y --no-install-recommends "${missing[@]}"
    fi
  fi

  local pixi
  pixi="$(command -v pixi || echo "$HOME/.pixi/bin/pixi")"
  if [[ -x "$pixi" ]]; then
    say "2/4 Pixi: already installed ($("$pixi" --version))."
  else
    say "2/4 Pixi: installing $pixi_version to ~/.pixi"
    run_sh "curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=v$pixi_version bash"
    pixi="$HOME/.pixi/bin/pixi"
  fi

  say "3/4 ROS 2 environment: pixi install -e default (CUDA packages resolve without a GPU)"
  run_sh "cd '$ws' && CONDA_OVERRIDE_CUDA=\${CONDA_OVERRIDE_CUDA:-13.2} '$pixi' install --environment default"

  if [[ -d "$ws/build" ]] && grep -rqs --include=CMakeCache.txt ".pixi/envs/" "$ws/build" &&
    ! grep -rqs --include=CMakeCache.txt "$ws/.pixi/envs/default/" "$ws/build"; then
    say "ros2_ws/build was made in a container or another environment: removing build/ install/ log/"
    run rm -rf "$ws/build" "$ws/install" "$ws/log"
  fi

  say "4/4 Build: colcon build in the default environment"
  run "$repo_root/tooling/host-ros2" build

  if [[ "$DRY_RUN" == 1 ]]; then
    say "DRY_RUN=1: nothing was changed."
  else
    say "Ready. Run anything with tooling/host-ros2, for example:"
    say "  tooling/host-ros2 ros2 launch chassis_bringup sim_gz.launch.py rviz:=true"
  fi
}

platform="${1:-auto}"
case "$platform" in
  -h|--help) usage; exit 0 ;;
esac
[[ $# -le 1 ]] || { usage >&2; exit 2; }

if [[ "$platform" == auto ]]; then
  platform="$(detect)"
  say "This machine ($machine$(has_nvidia && echo ', NVIDIA GPU' || echo ', no NVIDIA GPU')) uses the '$platform' setup."
fi
reason="$(misfit "$platform")"
[[ -z "$reason" ]] || die "$reason"
[[ "$DRY_RUN" == 1 ]] && say "DRY_RUN=1: showing what would be installed; nothing is changed."

case "$platform" in
  x86-cpu) setup_x86_cpu ;;
  x86)
    if [[ "$DRY_RUN" == 1 ]]; then
      DRY_RUN=1 "$repo_root/tooling/install-x86-host"
      printf '  would run: make setup x86\n'
    else
      exec make -C "$repo_root" setup x86
    fi ;;
  *)
    if [[ "$DRY_RUN" == 1 ]]; then
      printf '  would run: make setup %s\n' "$platform"
    else
      exec make -C "$repo_root" setup "$platform"
    fi ;;
esac
