{
  // Apple-Silicon Mac (Docker Desktop) ground station. Container settings (CPU rendering,
  // published Foxglove port, mounts) live in docker/compose.yaml, service `mac`, shared
  // with `make`.
  "name": "desktop-roshumble-mac-cpu",
  "dockerComposeFile": ["../../docker/compose.yaml"],
  "service": "mac",
  "runServices": ["mac"],
  "workspaceFolder": "/workspaces/billee-software-2027",

  "postStartCommand": "tooling/container-init",

  "containerUser": "root",
  "remoteUser": "root",

  // Foxglove Studio on the macOS host connects to the container's foxglove_bridge here.
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Foxglove bridge" }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ]
    }
  }
}
