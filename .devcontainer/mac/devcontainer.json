{
  "name": "desktop-roshumble-mac-cpu",
  "build": {
    "dockerfile": "../../docker/Dockerfile.desktop.mac.humble",
    "context": "../.."
  },

  "containerUser": "root",
  "remoteUser": "root",

  // Mount the whole repo (so git works) at the same /workspaces/<clone name> path the Linux devcontainers use.
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/ros2_ws",
  // Pixi envs are not relocatable: reinstall if the env was created under a different mount path.
  "postStartCommand": "if ! grep -Fq \"'exec' $PWD/.pixi/envs/mac-cpu/bin/python\" .pixi/envs/mac-cpu/bin/ros2 2>/dev/null; then pixi clean --environment mac-cpu || true; pixi install --environment mac-cpu; fi",

  // Foxglove Studio on the macOS host connects to the container's foxglove_bridge here.
  // There is no host networking on Docker Desktop, so this forward is how :8765 gets out.
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": { "label": "Foxglove bridge" }
  },

  "containerEnv": {
    "ROS_DISTRO": "humble",
    "BILLEE_PIXI_ENV": "mac-cpu",
    // No GPU passthrough on Apple Silicon Docker — force the mesa llvmpipe software
    // renderer so Gazebo (under xvfb-run) does not probe for a nonexistent GPU.
    "LIBGL_ALWAYS_SOFTWARE": "1",
    "GALLIUM_DRIVER": "llvmpipe"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ]
    }
  }
}
