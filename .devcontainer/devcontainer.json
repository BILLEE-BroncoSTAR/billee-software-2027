{
  "name": "desktop-roshumble_dev-x862",
   "build": {
    "dockerfile": "../docker/Dockerfile.desktop.humble",
    "context": "../"
  },

  "initializeCommand": "xhost +local:",

  "containerUser": "ros_user",
  "remoteUser": "ros_user",


  "runArgs": [
    "--privileged",
    "--gpus", "all",
    "-e=NVIDIA_VISIBLE_DEVICES=all",
    "-e=NVIDIA_DRIVER_CAPABILITIES=all,graphics",
    "--network=host",
    "--pid=host",
    "--ipc=host",
    "--hostname=ros-dev",
	  "--volume", "/tmp/.X11-unix:/tmp/.X11-unix",
	  "--volume", "/dev:/dev",
	  "--volume", "/dev/shm:/dev/shm"
  ],

  "postStartCommand": "cd ros2_ws && pixi install",

  "containerEnv": {
    "ROS_DISTRO": "humble",
    "DISPLAY": "${localEnv:DISPLAY}",
    //must have these to forward graphics card into container COMMENT OUT IF YOU ARE NOT USING GPU
    "NVIDIA_DRIVER_CAPABILITIES": "all",
     "__GLX_VENDOR_LIBRARY_NAME": "nvidia",
    "__NV_PRIME_RENDER_OFFLOAD": "1"
    //"LIBGL_ALWAYS_SOFTWARE": "1"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ],
      "settings": {
        "python-envs.defaultEnvManager": "ms-python.python:system",
        // host networking + --pid=host makes VS Code's port scanner see every
        // listening socket on the host (incl. its own forwarding helper), which
        // runs away spawning hundreds of 3073x forwards. Disable auto-forward.
        "remote.autoForwardPorts": false,
        "remote.autoForwardPortsFallback": 0,
        "remote.restoreForwardedPorts": false,
        "remote.otherPortsAttributes": {
          "onAutoForward": "ignore"
        }
      }
    }
  }

}
