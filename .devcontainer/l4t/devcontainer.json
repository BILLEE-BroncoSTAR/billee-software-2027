{
  "name": "rover-roshumble_l4t-aarch64",
  "build": {
    "dockerfile": "../../docker/Dockerfile.l4t-humble",
    "context": "../../",
    // Parallel OpenPose compile jobs; empty = all cores. `export OPENPOSE_JOBS=2` on the host
    // before "Rebuild Container" if nvcc runs out of RAM.
    "args": { "OPENPOSE_JOBS": "${localEnv:OPENPOSE_JOBS}" }
  },

  "containerUser": "ros_user",
  "remoteUser": "ros_user",

  "runArgs": [
    "--privileged",
    // Jetson (AGX Orin / Orin Nano): use the nvidia runtime, NOT "--gpus all".
    "--runtime", "nvidia",
    // ...and request the GPU through CDI (JetPack 7 keeps the spec in /var/run/cdi/nvidia.yaml).
    // CDI's host video/render gids reach only the container's first process, not VS Code's
    // `docker exec` terminals: postStartCommand's gpu_groups.sh adds them to ros_user for those
    // ("CUDA error 100/801" otherwise).
    "--device", "nvidia.com/gpu=all",
    "-e=NVIDIA_VISIBLE_DEVICES=all",
    "-e=NVIDIA_DRIVER_CAPABILITIES=all",
    "--network=host",
    "--pid=host",
    "--ipc=host",
    "--hostname=rover",
    // host networking copies the host's /etc/hosts, which lacks "rover" (sudo warns otherwise)
    "--add-host=rover:127.0.1.1",
    "--volume", "/dev:/dev",
    "--volume", "/dev/shm:/dev/shm",
    // kept only for optional local debugging on a Jetson with a display attached
    "--volume", "/tmp/.X11-unix:/tmp/.X11-unix"
  ],

  "postStartCommand": "sudo /usr/local/bin/gpu_groups.sh && cd ros2_ws && pixi install --environment l4t",

  "containerEnv": {
    "ROS_DISTRO": "humble",
    "BILLEE_PIXI_ENV": "l4t",
    // pixi's package cache inside the workspace mount (ros2_ws/.pixi is git-ignored), so the env
    // hardlinks from it instead of copying (no hardlinks across mounts): halves the disk the env
    // needs on the Jetson's SD card, and the cache survives container rebuilds.
    "PIXI_CACHE_DIR": "${containerWorkspaceFolder}/ros2_ws/.pixi/cache",
    "NVIDIA_DRIVER_CAPABILITIES": "all",
    "DISPLAY": "${localEnv:DISPLAY}"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ],
      "settings": {
        "python-envs.defaultEnvManager": "ms-python.python:system",
        // host networking + --pid=host makes VS Code's port scanner see every
        // listening socket on the host (incl. its own forwarding helper), which
        // runs away spawning hundreds of 3073x forwards. Disable auto-forward.
        "remote.autoForwardPorts": false,
        "remote.autoForwardPortsFallback": 0,
        "remote.restoreForwardedPorts": false,
        "remote.otherPortsAttributes": {
          "onAutoForward": "ignore"
        }
      }
    }
  }
}
