{
  // Windows + WSL2 + NVIDIA ground station. Container settings (GPU through /usr/lib/wsl,
  // WSLg display, mounts) live in docker/compose.yaml, service `wsl`, shared with `make`.
  "name": "desktop-roshumble_dev-wsl",
  "dockerComposeFile": ["../../docker/compose.yaml"],
  "service": "wsl",
  "runServices": ["wsl"],
  "workspaceFolder": "/workspaces/billee-software-2027",

  // Let the container open X11 windows on WSLg (RViz, Gazebo).
  "initializeCommand": "xhost +local: || true",
  "postStartCommand": "tooling/container-init",

  "containerUser": "ros_user",
  "remoteUser": "ros_user",

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "renan-r-santos.pixi-code",
        "Ranch-Hand-Robotics.urdf-editor",
        "ms-vscode.cpptools",
        "ms-vscode.cmake-tools",
        "smilerobotics.urdf",
        "waderyan.gitblame"
      ],
      "settings": {
        "python-envs.defaultEnvManager": "ms-python.python:system",
        // host networking + --pid=host makes VS Code's port scanner see every
        // listening socket on the host (incl. its own forwarding helper), which
        // runs away spawning hundreds of 3073x forwards. Disable auto-forward.
        "remote.autoForwardPorts": false,
        "remote.autoForwardPortsFallback": 0,
        "remote.restoreForwardedPorts": false,
        "remote.otherPortsAttributes": {
          "onAutoForward": "ignore"
        }
      }
    }
  }
}
