<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>zed_openpose</name>
  <version>0.0.0</version>
  <description>ROS 2 port of stereolabs/zed-openpose: CMU OpenPose (CUDA) on the ZED 2, skeletons placed in 3D in the rover's TF tree. Jetson only.</description>
  <maintainer email="luquilanzi@gmail.com">LucaLanzi</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ZED SDK and OpenPose are system installs on the Jetson image, not rosdep keys. -->
  <depend>rclcpp</depend>
  <depend>people_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>visualization_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
