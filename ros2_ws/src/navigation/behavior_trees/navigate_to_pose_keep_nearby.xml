<!--
  BILLEE NavigateToPose tree: Humble's stock
  nav2_bt_navigator/behavior_trees/navigate_to_pose_w_replanning_and_recovery.xml (BT.CPP v3 format)
  with ONE change: every ClearEntireCostmap is ClearCostmapExceptRegion (stock Nav2 BT node),
  which keeps the obstacles in a 4 x 4 m square around the rover (reset_distance 4.0) and clears
  the rest.

  Why: the rover's only obstacle sensor is a forward depth camera, so walls beside or behind it
  can't be re-observed. With ClearEntireCostmap, each recovery erased them; in the blocked-goal test
  the next path then ran along a forgotten pen wall and DWB drove the rover's side into it.
  Everything else (replan at 1 Hz, Spin / Wait / BackUp, 6 retries) is unchanged.
-->

<!--
  This Behavior Tree replans the global path periodically at 1 Hz and it also has
  recovery actions specific to planning / control as well as general system issues.
  This will be continuous if a kinematically valid planner is selected.
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <RateController hz="1.0">
          <RecoveryNode number_of_retries="1" name="ComputePathToPose">
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_except_global_costmap" reset_distance="4.0"/>
          </RecoveryNode>
        </RateController>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearCostmapExceptRegion name="ClearLocalCostmap-Context" service_name="local_costmap/clear_except_local_costmap" reset_distance="4.0"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearCostmapExceptRegion name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_except_local_costmap" reset_distance="4.0"/>
            <ClearCostmapExceptRegion name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_except_global_costmap" reset_distance="4.0"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
