<?xml version="1.0" ?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" >
  <material name="silver">
    <color rgba="0.700 0.700 0.700 1.000"/>
  </material>
  <!--xacro:include filename="$(find chassis_description)/urdf/chassis_model.trans" /-->
  <!--xacro:include filename="$(find chassis_description)/urdf/chassis_model.gazebo" /-->
  <!-- New dummy root link with no inertia so KDL as a root node w/ no inertia while base_link still keeps physics intact-->
  <link name="base_footprint"/>
  <joint name="dummy_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- base_link is located midway between the two centre wheel axes. -->
    <origin rpy="0.0 0.0 0.0" xyz="0.3624 0 0.115"/>
  </joint>
  <link name="base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="-0.0597906904116671 4.957188589394069e-17 0.2438059656754355"/>
      <mass value="368.7010327977625"/>
      <inertia ixx="7.357137" ixy="-0.0" ixz="-0.006189" iyy="12.009665" iyz="-0.0" izz="17.59793"/>
    </inertial>
    <visual>
      <origin rpy="0 0 ${pi}" xyz="0.3624 0 0.244"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin rpy="0 0 ${pi}" xyz="0.3624 0 0.244"/>
      <geometry>
        <mesh filename="package://robot_description/meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
