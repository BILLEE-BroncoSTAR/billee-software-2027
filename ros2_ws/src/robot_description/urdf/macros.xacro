<?xml version="1.0" ?>
<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro" >

    <xacro:macro name="white">
    <visual>
        <material>
        <ambient>1 1 1 1</ambient>
        <diffuse>1 1 1 1</diffuse>
        <specular>0.1 0.1 0.1 1</specular>
        </material>
    </visual>
    </xacro:macro>

    <xacro:macro name="black">
        <visual>
            <material>
                <ambient>0.02 0.02 0.02 1</ambient>
                <diffuse>0.02 0.02 0.02 1</diffuse>
                <specular>0.4 0.4 0.4 1</specular>
            </material>
        </visual>
    </xacro:macro>
    <xacro:macro name="orange">
        <visual>
            <material>
                <ambient>1 0.2 0 1</ambient>
                <diffuse>1 0.2 0 1</diffuse>
                <specular>0.05 0.05 0.05 1</specular>
            </material>
        </visual>
    </xacro:macro>
    <xacro:macro name="dark_grey">
        <visual>
            <material>
            <ambient>0.2 0.2 0.2 1</ambient>
            <diffuse>0.2 0.2 0.2 1</diffuse>
            <specular>0.1 0.1 0.1 1</specular>
            </material>
        </visual>
    </xacro:macro>

    <!-- Simulated depth camera resolution (robot.urdf.xacro args sim_camera_width/height).
         The point cloud has one point per pixel, 24 bytes each: at 1280x720 that is 22 MB per
         cloud, which DDS mostly drops, so the Nav2 costmaps received almost no clouds. 320x180
         (1.4 MB) matches the density of the real ZED cloud (zed_openpose cloud_step 4 on HD720).
         The intrinsics below follow the width, so the field of view stays 120 deg. -->
    <xacro:property name="zed_width" value="$(arg sim_camera_width)" />
    <xacro:property name="zed_height" value="$(arg sim_camera_height)" />
    <xacro:property name="zed_horizontal_fov_deg" value="120" />
    <xacro:property name="zed_horizontal_fov" value="${zed_horizontal_fov_deg * pi / 180.0}" />
    <xacro:property name="zed_fx" value="${zed_width / (2 * tan(zed_horizontal_fov / 2))}" />
    <xacro:property name="zed_fy" value="${zed_fx}" />
    <xacro:property name="zed_cx" value="${zed_width / 2.0}" />
    <xacro:property name="zed_cy" value="${zed_height / 2.0}" />


</robot>
