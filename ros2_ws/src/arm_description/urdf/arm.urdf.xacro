<?xml version="1.0"?>
<!-- The arm as the rover sees it: the arm model (arm_model.urdf.xacro, generated by
     import_urdf.py), fixed to the rover, with the RealSense D435i on its end effector.

     This is the only file that knows the model's link names, through the two properties the
     model defines (arm_model_root_link / arm_model_tip_link), so a re-imported URDF drops in.

       <xacro:include filename="$(find arm_description)/urdf/arm.urdf.xacro"/>
       <xacro:billee_arm parent="base_link" prefix="arm_" camera="true"
                         camera_xyz="-0.09 0 0.045" camera_rpy="0 0 3.14159">
         <origin xyz="0.25 0 0.329" rpy="0 0 0"/>
       </xacro:billee_arm>

     Frames it adds (prefix arm_):
       parent -> arm_<root link> ... arm joints (joint_arm_1..5) ... arm_<tip link>
       arm_<tip link> -> arm_camera_mount -> arm_cam_bottom_screw_frame -> arm_cam_link
     realsense2_camera then publishes arm_cam_link -> arm_cam_color_optical_frame (its own
     calibrated extrinsics, use_nominal_extrinsics false), and aruco_node publishes
     arm_cam_color_optical_frame -> aruco_<id>. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find arm_description)/urdf/arm_model.urdf.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d435i.urdf.xacro"/>

  <!-- camera_xyz / camera_rpy: arm_camera_mount (the D435i's bottom tripod screw, x out of the
       lens, z up through the camera's top) in the tip link's frame. The defaults put it on top
       of the current end effector housing, looking along the fingers (-x of link_5_endeff_1).
       MEASURE these on the real arm: every keyboard position goes through them. -->
  <xacro:macro name="billee_arm"
               params="parent prefix:=arm_ camera:=true camera_name:=arm_cam
                       camera_xyz:='-0.09 0 0.045' camera_rpy:='0 0 3.14159265'
                       use_nominal_extrinsics:=false *origin">
    <xacro:arm_model prefix="${prefix}"/>

    <joint name="${prefix}mount_joint" type="fixed">
      <xacro:insert_block name="origin"/>
      <parent link="${parent}"/>
      <child link="${prefix}${arm_model_root_link}"/>
    </joint>

    <!-- The end effector's frame under a fixed name, whatever the model calls its tip link:
         planners and the keyboard tools use arm_tool_link, not link_5_endeff_1. -->
    <link name="${prefix}tool_link"/>
    <joint name="${prefix}tool_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}${arm_model_tip_link}"/>
      <child link="${prefix}tool_link"/>
    </joint>

    <xacro:if value="${camera}">
      <link name="${prefix}camera_mount"/>
      <joint name="${prefix}camera_mount_joint" type="fixed">
        <origin xyz="${camera_xyz}" rpy="${camera_rpy}"/>
        <parent link="${prefix}tool_link"/>
        <child link="${prefix}camera_mount"/>
      </joint>
      <xacro:sensor_d435i parent="${prefix}camera_mount" name="${camera_name}"
                          use_nominal_extrinsics="${use_nominal_extrinsics}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:sensor_d435i>
    </xacro:if>
  </xacro:macro>
</robot>
