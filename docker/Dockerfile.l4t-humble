# NVIDIA Jetson (L4T) rover image.
#
# Structural mirror of docker/Dockerfile.desktop.humble: a CUDA-capable base ->
# apt basics -> non-root `ros_user` -> ZED SDK -> CMU OpenPose (CUDA) -> pixi in /opt/pixi ->
# `CMD ["pixi", "shell"]`. ROS 2 Humble itself comes from pixi / RoboStack (see
# ros2_ws/pixi.toml, environment `l4t`)
#
# Running on jetpack v6.x: the Isaac ROS base is built on L4T 36.4 (JetPack 6.1/6.2) with CUDA 12.6,
# cuDNN 9 and TensorRT 10.3.

FROM nvcr.io/nvidia/isaac/ros:aarch64-ros2_humble_4c0c55dddd2bbcc3e8d5f9753bee634c

ARG PIXI_VERSION=0.76.1

# create a non-root user (matches Dockerfile.desktop.humble)
ARG USERNAME=ros_user
ARG USER_UID=1000
ARG USER_GID=1000

ARG DEBIAN_FRONTEND=noninteractive

# ZED SDK 5.4 for L4T 36.4, the base's L4T (5.4's L4T 39.2 build is for JetPack 7)
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=4
ARG L4T_MAJOR=36
ARG L4T_MINOR=4

ENV NVIDIA_DRIVER_CAPABILITIES=all

# The Isaac ROS base ships an apt source for dl.yarnpkg.com whose signing key no longer verifies,
# which makes every `apt-get update` exit non-zero. yarn is already installed in the base and
# nothing here needs updates from it, so drop the source; every apt-get update below can then
# fail the build on a real error instead of being masked with `|| true`.
RUN rm -f /etc/apt/sources.list.d/yarn.list && \
  apt-get update && apt-get install -y --no-install-recommends \
  apt-utils \
  bash-completion \
  build-essential \
  cmake \
  curl \
  dialog \
  git \
  jq \
  less \
  libpq-dev \
  lsb-release \
  python3 \
  python3-dev \
  python3-pip \
  python3-wheel \
  sudo \
  tmux \
  udev \
  usbutils \
  wget \
  zstd && \
  rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 base images (incl. nvcr.io/nvidia/l4t-jetpack:r39.x) ship a default
# 'ubuntu' user at UID/GID 1000 — remove it so ros_user can own 1000.
RUN userdel -r ubuntu 2>/dev/null || true; \
  groupadd --gid ${USER_GID} ${USERNAME} && \
  useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} && \
  mkdir -p /home/${USERNAME}/ros2_ws/src && \
  chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/ros2_ws && \
  usermod -aG sudo ${USERNAME} && \
  echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && \
  chmod 0440 /etc/sudoers.d/${USERNAME}

# The ZED installer checks /etc/nv_tegra_release, which only exists on the host: write the L4T
# version there as stereolabs/zed-docker does. It detects the CPU with `file` and apt-installs its
# own deps, so the apt lists are dropped only after it; no `|| true`, so a failed install fails the
# build instead of leaving an image without the SDK. zed_openpose needs the SDK readable by the
# devcontainer's remapped ros_user uid, and settings/ + resources/ (calibration, AI models fetched
# at run time) writable.
RUN apt-get update && apt-get install -y --no-install-recommends \
      file libusb-1.0-0-dev zlib1g-dev libgeographic-dev && \
    echo "# R${L4T_MAJOR} (release), REVISION: ${L4T_MINOR}.0" > /etc/nv_tegra_release && \
    wget -q --no-check-certificate -O ZED_SDK_Linux_JP.run \
      "https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}/l4t${L4T_MAJOR}.${L4T_MINOR}/jetsons" && \
    chmod +x ZED_SDK_Linux_JP.run && \
    ./ZED_SDK_Linux_JP.run silent skip_tools skip_cuda skip_drivers skip_python && \
    rm -rf ZED_SDK_Linux_JP.run /usr/local/zed/resources/* /var/lib/apt/lists/* && \
    chmod -R a+rX /usr/local/zed && chmod -R a+rwX /usr/local/zed/settings /usr/local/zed/resources

# CMU OpenPose with CUDA + cuDNN, for zed_openpose (port of stereolabs/zed-openpose), into
# /opt/openpose: its build deps, then docker/build_openpose.sh, which clones, patches it for
# current CUDA / protobuf and builds it for sm_87 (Orin, AGX and Nano). Models are not downloaded
# here (CMU's server is offline): see ros2_ws/src/perception/zed_openpose/scripts/
# get_openpose_models.sh. Lower OPENPOSE_JOBS on an Orin Nano if nvcc runs out of RAM.
# Two quirks of the Isaac ROS base:
#  - It ships only the cuDNN runtime (libcudnn9-cuda-12): the matching dev + headers packages are
#    pinned to that exact version, or apt would pull the CUDA repo's newest cuDNN alongside it.
#  - OpenCV is NOT listed: the base already has Ubuntu's libopencv-dev 4.5.4, and asking for it
#    again makes apt "upgrade" it to the Jetson repo's 4.8 dev package, whose CMake config points
#    at /usr/lib/libopencv_*.so.4.8.0 libraries that are never installed.
RUN apt-get update && \
    cudnn=$(dpkg-query -W -f='${Version}' libcudnn9-cuda-12) && \
    apt-get install -y --no-install-recommends \
      libcudnn9-dev-cuda-12=${cudnn} libcudnn9-headers-cuda-12=${cudnn} \
      libprotobuf-dev protobuf-compiler libgoogle-glog-dev libgflags-dev \
      libboost-filesystem-dev libboost-system-dev libboost-thread-dev \
      libhdf5-dev libatlas-base-dev && \
    rm -rf /var/lib/apt/lists/*
ARG OPENPOSE_JOBS=
COPY docker/build_openpose.sh /tmp/build_openpose.sh
RUN OPENPOSE_JOBS=${OPENPOSE_JOBS} sh /tmp/build_openpose.sh /tmp/openpose && \
    echo /opt/openpose/lib > /etc/ld.so.conf.d/openpose.conf && ldconfig && \
    rm -rf /tmp/openpose /tmp/build_openpose.sh

# GPU access as ros_user: joins the host gids of the GPU device nodes at container start (see the
# script; the devcontainer's postStartCommand runs it)
COPY docker/gpu_groups.sh /usr/local/bin/gpu_groups.sh
RUN chmod 755 /usr/local/bin/gpu_groups.sh

# pixi -> provides ROS 2 Humble + colcon via the `l4t` environment in ros2_ws/pixi.toml
ENV PIXI_HOME=/opt/pixi
ENV PATH=${PIXI_HOME}/bin:${PATH}
RUN curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=v${PIXI_VERSION} PIXI_HOME=${PIXI_HOME} bash

USER root

