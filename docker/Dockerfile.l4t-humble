# NVIDIA Jetson (L4T) rover image.
#
# Structural mirror of docker/Dockerfile.desktop.humble: a CUDA-capable base ->
# apt basics -> non-root `ros_user` -> ZED SDK -> CMU OpenPose (CUDA) -> pixi in /opt/pixi ->
# `CMD ["pixi", "shell"]`. ROS 2 Humble itself comes from pixi / RoboStack (see
# ros2_ws/pixi.toml, environment `l4t`)
#
# Running on JetPack 7.2 (L4T r39.2, Ubuntu 24.04, CUDA 13.2). The image is keyed to the L4T
# version, not the board: the same build runs on the AGX Orin (BILLEE 2027 rover) and the Orin
# Nano, as long as the host is flashed with the same JetPack. NVIDIA publishes no
# l4t-jetpack image for JetPack 7, so (like stereolabs/zed-docker base/l4t) this starts from
# ubuntu:24.04 and installs only the CUDA / cuDNN / TensorRT pieces the ZED SDK and OpenPose
# need from NVIDIA's Jetson apt repo (~7.5 GB instead of nvidia-jetpack's ~16.5 GB).

ARG IMAGE_NAME=ubuntu:24.04

FROM ${IMAGE_NAME}

ARG PIXI_VERSION=0.76.1

# create a non-root user (matches Dockerfile.desktop.humble)
ARG USERNAME=ros_user
ARG USER_UID=1000
ARG USER_GID=1000

ARG DEBIAN_FRONTEND=noninteractive

# Jetson apt repo release (r39.2 also serves the r39.2.1 point release) and the matching CUDA
ARG L4T_VERSION=r39.2
ARG CUDA_VERSION=13-2
# ZED SDK 5.5 is the newest release with an L4T 39.2 build
ARG ZED_SDK_MAJOR=5
ARG ZED_SDK_MINOR=5

ENV NVIDIA_DRIVER_CAPABILITIES=all

RUN apt-get update || true && apt-get install -y --no-install-recommends \
  apt-utils \
  bash-completion \
  build-essential \
  cmake \
  curl \
  dialog \
  git \
  jq \
  less \
  libpq-dev \
  lsb-release \
  python3 \
  python3-dev \
  python3-pip \
  python3-wheel \
  sudo \
  tmux \
  udev \
  usbutils \
  wget \
  zstd && \
  rm -rf /var/lib/apt/lists/*

# Ubuntu 24.04 base images (incl. nvcr.io/nvidia/l4t-jetpack:r39.x) ship a default
# 'ubuntu' user at UID/GID 1000 — remove it so ros_user can own 1000.
RUN userdel -r ubuntu 2>/dev/null || true; \
  groupadd --gid ${USER_GID} ${USERNAME} && \
  useradd --uid ${USER_UID} --gid ${USER_GID} -m -s /bin/bash ${USERNAME} && \
  mkdir -p /home/${USERNAME}/ros2_ws/src && \
  chown -R ${USERNAME}:${USERNAME} /home/${USERNAME}/ros2_ws && \
  usermod -aG sudo ${USERNAME} && \
  echo "${USERNAME} ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/${USERNAME} && \
  chmod 0440 /etc/sudoers.d/${USERNAME}

# CUDA (nvcc + runtime libs, plus the dev libs Caffe and the ZED SDK's cmake link: NPP, cuBLAS,
# cuRAND), cuDNN and the TensorRT runtime (ZED NEURAL depth) from the Jetson repo. The pin keeps
# Ubuntu's own conflicting nvidia-* packages out; the marker file stops l4t postinst scripts from
# trying a boot-firmware update inside the build.
RUN mkdir -p /opt/nvidia/l4t-packages && \
    touch /opt/nvidia/l4t-packages/.nv-l4t-disable-boot-fw-update-in-preinstall && \
    printf 'Package: *\nPin: origin repo.download.nvidia.com\nPin-Priority: 1001\n' \
      > /etc/apt/preferences.d/nvidia-l4t && \
    echo 'Acquire::Retries "10"; Acquire::http::Timeout "60";' > /etc/apt/apt.conf.d/99retries && \
    curl -fsSL https://repo.download.nvidia.com/jetson/jetson-ota-public.asc \
      -o /etc/apt/trusted.gpg.d/nvidia-l4t.asc && \
    echo "deb https://repo.download.nvidia.com/jetson/common ${L4T_VERSION} main" \
      > /etc/apt/sources.list.d/nvidia-l4t.list && \
    echo "deb https://repo.download.nvidia.com/jetson/som ${L4T_VERSION} main" \
      >> /etc/apt/sources.list.d/nvidia-l4t.list && \
    apt-get update && apt-get install -y --no-install-recommends \
      cuda-nvcc-${CUDA_VERSION} cuda-cudart-dev-${CUDA_VERSION} cuda-libraries-${CUDA_VERSION} \
      libnpp-dev-${CUDA_VERSION} libcublas-dev-${CUDA_VERSION} libcurand-dev-${CUDA_VERSION} \
      libcudnn9-dev-cuda-13 libnvinfer10 libnvinfer-plugin10 libnvonnxparsers10 && \
    rm -rf /var/lib/apt/lists/* && \
    ln -sfn /usr/local/cuda-$(echo ${CUDA_VERSION} | tr - .) /usr/local/cuda
ENV CUDA_HOME=/usr/local/cuda
ENV PATH=/usr/local/cuda/bin:${PATH}
ENV LD_LIBRARY_PATH=/usr/local/cuda/lib64

# The ZED installer checks /etc/nv_tegra_release, which only exists on the host: write the L4T
# version there as stereolabs/zed-docker does. The installer detects the CPU with `file` and
# apt-installs its own deps, so the apt lists are dropped only after it. The libv4l2 link is for
# ZED streaming in containers.
RUN apt-get update || true && apt-get install -y --no-install-recommends \
      file libusb-1.0-0-dev zlib1g-dev libgeographiclib-dev && \
    l4t=${L4T_VERSION#r} && \
    echo "# R${l4t%%.*} (release), REVISION: ${l4t#*.}" > /etc/nv_tegra_release && \
    wget -q --no-check-certificate -O ZED_SDK_Linux_JP.run \
      "https://download.stereolabs.com/zedsdk/${ZED_SDK_MAJOR}.${ZED_SDK_MINOR}/l4t${l4t}/jetsons" && \
    chmod +x ZED_SDK_Linux_JP.run && \
    ./ZED_SDK_Linux_JP.run silent skip_tools skip_drivers skip_python && \
    rm -rf ZED_SDK_Linux_JP.run /usr/local/zed/resources/* /var/lib/apt/lists/* && \
    ln -sf /usr/lib/aarch64-linux-gnu/tegra/libv4l2.so.0 /usr/lib/aarch64-linux-gnu/libv4l2.so && \
    chown -R ${USERNAME}:${USERNAME} /usr/local/zed

# CMU OpenPose with CUDA + cuDNN, for zed_openpose (port of stereolabs/zed-openpose), into
# /opt/openpose: its build deps (plus CUDA's Thrust/CUB headers, cuda-cccl, for Caffe), then
# docker/build_openpose.sh, which clones, patches it for CUDA 13 / cuDNN 9 / Ubuntu 24.04 and
# builds it for sm_87 (Orin, AGX and Nano). Models are not downloaded here (CMU's server is
# offline): see ros2_ws/src/perception/zed_openpose/scripts/get_openpose_models.sh. Lower
# OPENPOSE_JOBS on an Orin Nano if nvcc runs out of RAM.
RUN apt-get update && apt-get install -y --no-install-recommends \
      cuda-cccl-${CUDA_VERSION} \
      libprotobuf-dev protobuf-compiler libgoogle-glog-dev libgflags-dev \
      libboost-filesystem-dev libboost-system-dev libboost-thread-dev \
      libhdf5-dev libatlas-base-dev libopencv-dev && \
    rm -rf /var/lib/apt/lists/*
ARG OPENPOSE_JOBS=
COPY docker/build_openpose.sh /tmp/build_openpose.sh
RUN OPENPOSE_JOBS=${OPENPOSE_JOBS} sh /tmp/build_openpose.sh /tmp/openpose && \
    echo /opt/openpose/lib > /etc/ld.so.conf.d/openpose.conf && ldconfig && \
    rm -rf /tmp/openpose /tmp/build_openpose.sh

# pixi -> provides ROS 2 Humble + colcon via the `l4t` environment in ros2_ws/pixi.toml
ENV PIXI_HOME=/opt/pixi
ENV PATH=${PIXI_HOME}/bin:${PATH}
RUN curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=v${PIXI_VERSION} PIXI_HOME=${PIXI_HOME} bash

# Install autocomplete dependencies as root, plus the X11 / EGL / GLES loaders libsl_zed.so links
# (the Jetson-specific libs behind them are mounted from the host by the nvidia runtime)
USER root
RUN apt-get update && apt-get install -y \
    bash-completion libx11-6 libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*

# The ZED installer leaves /usr/local/zed at 770 for ros_user's build-time uid (1000), but the
# devcontainer remaps ros_user to the host user's uid (2002 on the dev Orin Nano) and only re-owns
# $HOME: make the SDK readable by anyone, and settings/ + resources/ (calibration files and AI
# models the SDK downloads at run time) writable.
RUN chmod -R a+rX /usr/local/zed && chmod -R a+rwX /usr/local/zed/settings /usr/local/zed/resources

# GPU access as ros_user: joins the host gids of the GPU device nodes at container start (see the
# script; the devcontainer's postStartCommand runs it)
COPY docker/gpu_groups.sh /usr/local/bin/gpu_groups.sh
RUN chmod 755 /usr/local/bin/gpu_groups.sh

# Ask the nvidia runtime for the GPU even under plain `docker run` (the devcontainer also passes it):
# without it, nothing from the host (libcuda, /dev/nvhost-*, the Tegra multimedia libs) is mounted.
ENV NVIDIA_VISIBLE_DEVICES=all

USER ${USERNAME}

# Copy the terminal config (autocomplete) script into the container
COPY docker/terminal_config.sh /tmp/terminal_config.sh

# Append the terminal config (autocomplete) script to .bashrc
RUN cat /tmp/terminal_config.sh >> ~/.bashrc

CMD ["pixi", "shell"]
