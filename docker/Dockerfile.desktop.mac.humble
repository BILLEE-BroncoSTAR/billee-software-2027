ARG UBUNTU_MAJOR=22
ARG UBUNTU_MINOR=04

FROM ubuntu:${UBUNTU_MAJOR}.${UBUNTU_MINOR}

ARG PIXI_VERSION
ARG DEBIAN_FRONTEND=noninteractive

ENV TZ=Europe/Paris
ENV PIXI_HOME=/opt/pixi
ENV PATH=${PIXI_HOME}/bin:${PATH}

RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo ${TZ} > /etc/timezone && \
    apt-get update && \
    apt-get install --yes --no-install-recommends \
      bash-completion \
      build-essential \
      cmake \
      curl \
      git \
      jq \
      less \
      libopencv-dev \
      libpq-dev \
      lsb-release \
      python3 \
      python3-dev \
      python3-pip \
      python3-wheel \
      tmux \
      wget \
      zstd && \
    rm -rf /var/lib/apt/lists/*

RUN : "${PIXI_VERSION:?build through docker/compose.yaml}" && \
    curl -fsSL https://pixi.sh/install.sh | PIXI_VERSION=v${PIXI_VERSION} PIXI_HOME=${PIXI_HOME} bash

# Headless GL for Gazebo Fortress on Apple-Silicon Docker (no GPU passthrough):
# xvfb provides the throwaway X display for `xvfb-run`, and a mesa new enough
# (kisak-mesa, as in Dockerfile.desktop.humble) gives an llvmpipe software
# renderer that satisfies ogre2's GL 3.3+ requirement.
RUN apt-get update && apt-get install -y --no-install-recommends software-properties-common gnupg \
    && add-apt-repository -y ppa:kisak/kisak-mesa \
    && apt-get update && apt-get install -y --no-install-recommends \
      xvfb x11-utils mesa-utils \
      libgl1 libgl1-mesa-dri libglx-mesa0 libglu1-mesa libegl1 libgles2 \
    && rm -rf /var/lib/apt/lists/*

# Same path docker/compose.yaml mounts the repo at. The repo mount hides this
# environment at run time, but installing it here fills Pixi's package cache in the
# image, so tooling/container-init installs the real one without downloading it again.
WORKDIR /workspaces/billee-software-2027/ros2_ws

COPY ros2_ws/pixi.toml ros2_ws/pixi.lock ./
RUN pixi install --environment mac-cpu

# Install autocomplete dependencies as root
RUN apt-get update && apt-get install -y \
    bash-completion \
    && rm -rf /var/lib/apt/lists/*

# Copy the terminal config (autocomplete) script into the container
COPY tooling/billee-env.sh /usr/local/lib/billee/billee-env.sh
COPY docker/terminal_config.sh /tmp/terminal_config.sh

# Append the terminal config (autocomplete) script to .bashrc
RUN cat /tmp/terminal_config.sh >> ~/.bashrc

CMD ["bash"]
