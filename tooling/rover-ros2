#!/usr/bin/env bash
# Build and run the NVIDIA Jetson (L4T) rover ROS 2 image without VS Code / Dev Containers.
# Kept for muscle memory: this is tooling/desktop-ros2 pinned to the l4t platform
# (docker/Dockerfile.l4t-humble, rover-ros2:latest, nvidia runtime).
#
#   tooling/rover-ros2 build [docker build args...]
#   tooling/rover-ros2 run [command...]
#   tooling/rover-ros2 shell
set -euo pipefail

BILLEE_PLATFORM=l4t exec "$(dirname "${BASH_SOURCE[0]}")/desktop-ros2" "$@"
