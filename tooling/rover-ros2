#!/usr/bin/env bash
# Build and run the NVIDIA Jetson (L4T) rover ROS 2 image without VS Code / Dev Containers.
# Parallel to tooling/desktop-ros2, but for docker/Dockerfile.l4t-humble and the
# nvidia container runtime (Jetson does not support `--gpus all`).
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
image="rover-ros2:latest"
dockerfile="$repo_root/docker/Dockerfile.l4t-humble"

usage() {
  cat <<'EOF'
Usage: tooling/rover-ros2 <build|run|shell> [arguments...]

  build  Build rover-ros2:latest from docker/Dockerfile.l4t-humble.
         Extra arguments are passed to `docker build` (e.g. --build-arg L4T_VERSION=...).
  run    Start the image with the same host, GPU (nvidia runtime), device, and
         workspace settings as .devcontainer/l4t/devcontainer.json. Extra
         arguments replace the image's default command.
  shell  Open a Bash shell with those same settings, bypassing the entrypoint.

Examples:
  tooling/rover-ros2 build
  tooling/rover-ros2 build --build-arg L4T_VERSION=r36.3.0
  tooling/rover-ros2 run
  tooling/rover-ros2 shell
  tooling/rover-ros2 run pixi run --environment l4t build
EOF
}

action="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$action" in
  build)
    exec docker build \
      --file "$dockerfile" \
      --tag "$image" \
      "$@" \
      "$repo_root"
    ;;
  run|shell)
    docker_args=(
      --rm
      --interactive
      --tty
      --privileged
      --runtime nvidia
      --env NVIDIA_VISIBLE_DEVICES=all
      --env NVIDIA_DRIVER_CAPABILITIES=all
      --network host
      --pid host
      --ipc host
      --hostname rover
      --add-host rover:127.0.1.1
      --volume /dev:/dev
      --volume /dev/shm:/dev/shm
      --volume /tmp/.X11-unix:/tmp/.X11-unix
      # Same layout as the devcontainer: whole repo at /workspaces/<clone name>
      --mount "type=bind,source=$repo_root,target=/workspaces/$(basename "$repo_root")"
      --workdir "/workspaces/$(basename "$repo_root")/ros2_ws"
      --env ROS_DISTRO=humble
      --env BILLEE_PIXI_ENV=l4t
      --env "PIXI_CACHE_DIR=/workspaces/$(basename "$repo_root")/ros2_ws/.pixi/cache"
      --env "DISPLAY=${DISPLAY:-}"
    )
    # CUDA as ros_user needs the host groups that own the GPU device nodes (gids differ per host;
    # the devcontainer gets them from docker/gpu_groups.sh instead)
    for gid in $(stat -c %g /dev/nvmap /dev/nvgpu/igpu0/* /dev/nvhost* /dev/host1x* /dev/dri/* \
                   2>/dev/null | sort -un); do
      [[ "$gid" == 0 ]] || docker_args+=(--group-add "$gid")
    done

    if [[ "$action" == shell ]]; then
      exec docker run "${docker_args[@]}" --entrypoint /bin/bash "$image" "$@"
    fi

    exec docker run "${docker_args[@]}" "$image" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
