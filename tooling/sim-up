#!/usr/bin/env bash

# sim-up - bringup the gazebo sim of the rover with the viewer that suits this platform
# Example Usage:
#   ./sim-up             - sim + gamepad teleop + foxglove bridge (:8765), RViz when there's a display
#   ./sim-up true false  - same, without the gamepad nodes
#
# Args: [foxglove=true] [joystick=true]. Environment overrides:
#   BILLEE_PLATFORM=<x86|wsl|mac>  Pixi env (default: from `make setup`, see tooling/billee-env.sh)
#   BILLEE_ROLE=ground     bypass the rover guard below
#   RVIZ=true|false        default: true on Linux/WSL with a display, false on mac / headless
#   JOY_SOURCE=device|browser  default: browser on mac and wsl (no USB pad there), else device
#   SHADOW=true|false      ODESC shadow on vcan0; default: true when vcan0 exists
#                          (create it on the host with `tooling/can-up vcan0`)
#   HEADLESS=1             force `xvfb-run -a` (automatic when there is no display)
set -euo pipefail

start_foxglove="${1:-true}"
use_controller="${2:-true}"

source "$(dirname "${BASH_SOURCE[0]}")/billee-env.sh"
if [[ -z "$BILLEE_WS" ]]; then
  echo "sim-up: can't find ros2_ws" >&2
  exit 1
fi

if [[ "$BILLEE_ROLE" == rover ]]; then
  echo "sim-up: this is the rover ($BILLEE_PLATFORM). Gazebo runs on the ground" >&2
  echo "sim-up:   station, not on the Jetson - the l4t environment has no Gazebo and" >&2
  echo "sim-up:   the image has no X server. On the Jetson you want: tooling/rover-up" >&2
  echo "sim-up:   To override anyway: BILLEE_ROLE=ground tooling/sim-up" >&2
  exit 1
fi

has_display=false
if [[ -n "${DISPLAY:-}${WAYLAND_DISPLAY:-}" && "${HEADLESS:-0}" != 1 && "$BILLEE_PLATFORM" != mac ]]; then
  has_display=true
fi

wrapper=()
if [[ "$has_display" == false ]]; then
  if command -v xvfb-run >/dev/null; then
    wrapper=(xvfb-run -a)
  else
    echo "sim-up: no display and no xvfb-run; Gazebo may fail to start" >&2
  fi
fi

# Mac: Foxglove on the host is the viewer. Linux with a display: RViz.
rviz="${RVIZ:-$has_display}"

shadow="${SHADOW:-}"
if [[ -z "$shadow" ]]; then
  if ip link show vcan0 &>/dev/null; then shadow=true; else shadow=false; fi
fi

# Docker Desktop on the Mac passes no USB through, and the stock WSL2 kernel has no
# joystick driver, so there a game pad can only reach ROS through the browser:
# Foxglove's Joystick panel publishes /joy itself. JOY_SOURCE=device|browser overrides.
joy_source="${JOY_SOURCE:-}"
if [[ -z "$joy_source" ]]; then
  case "$BILLEE_PLATFORM" in
    mac | wsl) joy_source=browser ;;
    *) joy_source=device ;;
  esac
fi

echo "sim-up: platform $BILLEE_PLATFORM, Pixi env $BILLEE_PIXI_ENV," \
  "rviz=$rviz foxglove=$start_foxglove odesc_shadow=$shadow joy_source=$joy_source"
if [[ "$start_foxglove" == true ]]; then
  echo "sim-up: Foxglove Studio -> ws://localhost:8765 (or ws://<this-machine-ip>:8765)"
fi
if [[ "$joy_source" == browser && "$use_controller" == true ]]; then
  echo "sim-up: game pad -> add Foxglove's 'Joystick [local]' panel, set Data Source:"
  echo "sim-up:   Gamepad, Publish Mode: On, Pub Joy Topic: /joy. Hold RB to drive."
fi
cd "$BILLEE_WS"
exec "${wrapper[@]}" pixi run --environment "$BILLEE_PIXI_ENV" \
  ros2 launch chassis_bringup sim_gz.launch.py \
  odesc_shadow:="$shadow" joy_control:="$use_controller" \
  joy_source:="$joy_source" \
  foxglove:="$start_foxglove" rviz:="$rviz"
