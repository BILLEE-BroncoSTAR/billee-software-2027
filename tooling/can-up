#!/usr/bin/env bash
# can-up — bring a SocketCAN interface up (or down) for the BILLEE drivetrain.
#
#   tooling/can-up                 # bring up can3 @ 500 kbit/s (real ODESC bus)
#   tooling/can-up can3            # same, explicit
#   tooling/can-up can3 250000     # override bitrate
#   tooling/can-up vcan0           # create + bring up a virtual CAN bus (testing)
#   tooling/can-up down [iface]    # take the interface down (vcanN is also deleted)
#   tooling/can-up status [iface]  # show state
#
# Bitrate default is 500000 to match BILLEE_NEO_ODESC_Hardware_Integration_Guide.md
# §3.4 (odrv0.can.config.baud_rate = 500000). Confirm against the actual ODESC
# firmware config before trusting it on real hardware.
#
# Uses sudo for the `ip` calls. Idempotent: re-running on an already-up interface
# just reports state. Real `canN` interfaces must already exist in the kernel
# (Tegra mttcan, or a plugged-in USB-CAN adapter); this script does not create
# them, only configures them. `vcanN` interfaces are created on demand.
#
# Real interfaces also get txqueuelen 100 (the kernel default for CAN is 10). The ODESC
# driver queues 12 frames per control cycle (6 velocity commands + 6 encoder requests);
# a 10-frame queue overflows into ENOBUFS.

# Sourcing would run `set -e` and `exit` in the caller's shell and close it (and the
# container, when that shell is the container's main process). Execute it instead.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
  echo "can-up: execute this script, don't source it:  ${BASH_SOURCE[0]} $*" >&2
  return 1
fi

set -euo pipefail

if ! command -v ip &>/dev/null; then
  echo "ERROR: 'ip' (iproute2) not found. Run can-up on the Jetson host, not in the container." >&2
  exit 1
fi

BITRATE_DEFAULT=500000
RESTART_MS=100
TXQUEUELEN=100

arg1="${1:-can3}"
arg2="${2:-}"

_status() {
  local ifc="$1"
  if ip link show "$ifc" &>/dev/null; then
    ip -details -brief link show "$ifc" || ip -details link show "$ifc"
  else
    echo "$ifc: does not exist"
  fi
}

case "$arg1" in
  status)
    _status "${arg2:-can3}"
    exit 0
    ;;
  down)
    ifc="${arg2:-can3}"
    echo ">> taking $ifc down"
    sudo ip link set "$ifc" down || true
    if [[ "$ifc" == vcan* ]] && ip link show "$ifc" &>/dev/null; then
      sudo ip link delete "$ifc" type vcan
      echo ">> deleted virtual interface $ifc"
    fi
    _status "$ifc"
    exit 0
    ;;
esac

ifc="$arg1"

if [[ "$ifc" == vcan* ]]; then
  # Virtual CAN bus for hardware-free protocol testing (candump/cansend, or
  # real.launch.py can_interface:=vcan0).
  if ! ip link show "$ifc" &>/dev/null; then
    # The module belongs to the host kernel. In a host-networked container the
    # interface may already have been created by the host, whose modules are
    # intentionally not installed in the container filesystem.
    if ! sudo modprobe vcan; then
      echo "ERROR: could not load the vcan kernel module." >&2
      echo "  - In a container, run 'tooling/can-up $ifc' on the Linux host first." >&2
      echo "  - On the host, install/load the modules matching: $(uname -r)" >&2
      exit 1
    fi
    sudo ip link add dev "$ifc" type vcan
    echo ">> created virtual interface $ifc"
  fi
  sudo ip link set "$ifc" up
  echo ">> $ifc is up (virtual, no bitrate)"
  _status "$ifc"
  exit 0
fi

# Real CAN interface.
bitrate="${arg2:-$BITRATE_DEFAULT}"

if ! ip link show "$ifc" &>/dev/null; then
  echo "ERROR: $ifc does not exist in the kernel." >&2
  echo "  - Tegra built-in CAN: check the transceiver wiring + pinmux/overlay." >&2
  echo "  - USB-CAN adapter: plug it in; it usually enumerates as can0/can1." >&2
  echo "  - For a hardware-free test bus use:  tooling/can-up vcan0" >&2
  exit 1
fi

# Safe while the interface is up, so it is applied on both paths below.
sudo ip link set "$ifc" txqueuelen "$TXQUEUELEN"

state="$(ip -brief link show "$ifc" | awk '{print $2}')"
if [[ "$state" == "UP" ]]; then
  echo ">> $ifc already UP; leaving it (txqueuelen set to ${TXQUEUELEN}). (down first to re-set the bitrate)"
  _status "$ifc"
  exit 0
fi

echo ">> bringing $ifc up @ ${bitrate} bit/s (restart-ms ${RESTART_MS}, txqueuelen ${TXQUEUELEN})"
sudo ip link set "$ifc" up type can bitrate "$bitrate" restart-ms "$RESTART_MS"
_status "$ifc"
echo ">> tip: 'candump $ifc' should show ODESC heartbeat frames (cmd 0x01) once nodes are powered."
