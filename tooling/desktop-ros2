#!/usr/bin/env bash
# Build, start and enter this machine's ROS 2 container without VS Code.
#
# A thin wrapper over docker/compose.yaml, which defines every platform's image, GPU
# flags, devices and mounts. The service follows the platform recorded by
# `make setup <platform>` (see tooling/billee-env.sh); override for one command with
# BILLEE_PLATFORM=<x86|wsl|mac|l4t>.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
source "$repo_root/tooling/billee-env.sh"

usage() {
  cat <<'EOF'
Usage: tooling/desktop-ros2 <build|up|down|run|shell> [arguments...]

  build  Build this platform's image. Extra arguments go to `docker compose build`
         (e.g. --no-cache).
  up     Start the platform's container in the background (no-op when it is running).
  down   Stop it.
  run    Start it if needed, make sure the Pixi environment is installed, then run a
         command in it. Extra arguments replace the default (`pixi shell -e <env>`).
  shell  Same, but open a plain Bash shell.

  Platform  Compose service  Image                  Dockerfile
  x86       x86              billee-desktop:latest  docker/Dockerfile.desktop.humble
  wsl       wsl              billee-desktop:latest  docker/Dockerfile.desktop.humble
  mac       mac              billee-mac-cpu:latest  docker/Dockerfile.desktop.mac.humble
  l4t       rover            rover-ros2:latest      docker/Dockerfile.l4t-humble

  Every service mounts the repo at /workspaces/billee-software-2027.

Examples:
  tooling/desktop-ros2 build
  tooling/desktop-ros2 shell
  tooling/desktop-ros2 run pixi run -e l4t build
  BILLEE_PLATFORM=l4t tooling/desktop-ros2 build
EOF
}

case "$BILLEE_PLATFORM" in
  x86 | wsl | mac) service="$BILLEE_PLATFORM" ;;
  l4t) service=rover ;;
  *)
    echo "desktop-ros2: unknown platform '$BILLEE_PLATFORM' - run 'make setup <platform>'" >&2
    exit 2
    ;;
esac

container_ws=/workspaces/billee-software-2027/ros2_ws
compose=(docker compose --file "$repo_root/docker/compose.yaml")

is_running() {
  [[ -n "$("${compose[@]}" ps --quiet --status running "$service" 2>/dev/null)" ]]
}

# Start the service unless it is already running. Not re-running `up` on a running
# service matters: VS Code starts the same service with its own override file, and a
# second `up` without it would recreate the container under the open editor.
ensure_up() {
  is_running && return 0
  # Let the container open X11 windows (RViz, Gazebo) - the Linux devcontainers'
  # initializeCommand does the same.
  if [[ "$BILLEE_PLATFORM" != mac && -n "${DISPLAY:-}" ]] && command -v xhost >/dev/null; then
    xhost +local: >/dev/null || true
  fi
  "${compose[@]}" up --detach "$service"
}

action="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$action" in
  build)
    exec "${compose[@]}" build "$@" "$service"
    ;;
  up)
    ensure_up
    ;;
  down)
    exec "${compose[@]}" stop "$service"
    ;;
  run|shell)
    ensure_up

    tty_args=()
    if [[ ! -t 0 || ! -t 1 ]]; then
      tty_args+=(--no-TTY)
    fi

    if [[ "$action" == shell ]]; then
      cmd=(bash)
    elif [[ $# -gt 0 ]]; then
      cmd=("$@")
    else
      cmd=(pixi shell --environment "$BILLEE_PIXI_ENV")
    fi

    # ${a[@]+...}: an empty array is an unbound variable to macOS's bash 3.2 under set -u.
    exec "${compose[@]}" exec ${tty_args[@]+"${tty_args[@]}"} \
      --env "BILLEE_PLATFORM=$BILLEE_PLATFORM" \
      --workdir "$container_ws" \
      "$service" \
      bash -c '../tooling/container-init && exec "$@"' bash "${cmd[@]}"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
