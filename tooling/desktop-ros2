#!/usr/bin/env bash
# Build and run the desktop ROS 2 image without VS Code / Dev Containers.
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
image="zed-ros2-desktop:latest"

usage() {
  cat <<'EOF'
Usage: scripts/desktop-ros2 <build|run|shell> [arguments...]

  build  Build zed-ros2-desktop:latest from docker/Dockerfile.desktop.humble.
  run    Start the image with the same host, GPU, device, X11, and workspace
         settings as .devcontainer/devcontainer.json. Extra arguments replace
         the image's default command.
  shell  Open a Bash shell with those same settings, bypassing the entrypoint.

Examples:
  scripts/desktop-ros2 build
  scripts/desktop-ros2 run
  scripts/desktop-ros2 shell
  scripts/desktop-ros2 run pixi run build
EOF
}

action="${1:-}"
if [[ $# -gt 0 ]]; then
  shift
fi

case "$action" in
  build)
    exec docker build \
      --file "$repo_root/scripts/Dockerfile.desktop.humble" \
      --tag "$image" \
      "$@" \
      "$repo_root"
    ;;
  run|shell)
    docker_args=(
      --rm
      --interactive
      --tty
      --privileged
      --gpus all
      --network host
      --pid host
      --ipc host
      --volume /tmp/.X11-unix:/tmp/.X11-unix
      --volume /dev:/dev
      --volume /dev/shm:/dev/shm
      --mount "type=bind,source=$repo_root/ros2_ws,target=/root/ros2_ws"
      --env ROS_DISTRO=humble
      --env "DISPLAY=${DISPLAY:-}"
      --env "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-}"
      --env "XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-}"
    )

    if [[ "$action" == shell ]]; then
      exec docker run "${docker_args[@]}" --entrypoint /bin/bash "$image" "$@"
    fi

    exec docker run "${docker_args[@]}" "$image" "$@"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
